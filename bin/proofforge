#!/usr/bin/env python3
"""proofforge: check a candidate against a locked task, and reproduce a Passport.

  proofforge check  --task T [--candidate PATH] [--out passport.json] [--comment comment.md]
                    [--no-counterexample]
  proofforge verify passport.json --candidate PATH [--strict-image]
  proofforge tasks  [--split S]

`check` runs the official pipeline (tree check, implementation scan, Comparator in a fresh
sandbox, leanchecker, axiom audit) and the binary property check, and writes a Passport. When
the candidate is REFUTED it also runs the counterexample stage (harness/counterexample.py):
each refuted requirement's witness becomes a Lean refutation of the locked requirement, checked
by Comparator's kernels, leanchecker and the axiom audit, and recorded under `counterexamples`.
`verify` re-runs the pipeline on the candidate and compares every recorded hash and status
with the given Passport; for a Passport with `counterexamples` it re-checks each recorded
refutation in a fresh container against a challenge regenerated from the locked files. It also
compares the Lean toolchain and the ProofForgeFin library record (whether the library was
vendored and, if so, its source tree hash, the modules imported and the library scan); a Passport
without a library record requires a candidate that does not import the library. A Passport whose
library version is not the checkout's is reproduced with the library sources of the commit it
records. The judge image digest is reported, and counted as a difference with --strict-image. Exit
code 0 means VERIFIED (check) or reproduced (verify).

The harness and locked tasks are read from this repository checkout, so in CI it must be a
trusted checkout (the base branch), with only candidate files taken from the change.
"""
import argparse, contextlib, json, pathlib, sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "harness"))
import counterexample as cexmod, fin_lib, passport, task as taskmod  # noqa: E402


def cmd_check(a):
    t = taskmod.load(a.task)
    cand = pathlib.Path(a.candidate) if a.candidate else t.start
    p = passport.run(cand, t, cases=a.cases, seed=a.seed,
                     counterexample=not getattr(a, "no_counterexample", False))
    p["reproduce"] = f"bin/proofforge verify {a.out or 'passport.json'} --candidate {a.candidate or cand}"
    p["passport_sha256"] = passport.content_hash(p)
    if a.out:
        pathlib.Path(a.out).write_text(json.dumps(p, indent=2) + "\n")
    md = passport.markdown(p)
    if a.comment:
        pathlib.Path(a.comment).write_text(md)
    print(md)
    return 0 if p["status"] == "VERIFIED" else 1


def cmd_verify(a):
    old = json.loads(pathlib.Path(a.passport).read_text())
    if old.get("passport_sha256") != passport.content_hash(old):
        print("NOT reproduced: Passport content hash differs")
        return 1
    t = taskmod.load(old["task"]["id"])
    cand = pathlib.Path(a.candidate)
    # The library version the Passport binds. A Passport issued before the library was integrated
    # has no `library` record; its candidate must not import the library now either. A Passport
    # whose library version is not this checkout's is reproduced with that version's sources,
    # extracted from the commit it records, when git has it.
    lib_old = old.get("library") or {"vendored": False}
    lib_root = None
    if lib_old.get("vendored") and lib_old.get("source_tree_sha256") != fin_lib.tree_sha256():
        if lib_old.get("git_commit"):
            lib_root = fin_lib.materialize(lib_old["git_commit"], lib_old["source_tree_sha256"])
        if lib_root:
            print(f"note  the Passport's library version {lib_old['source_tree_sha256'][:16]} is not this checkout's; "
                  f"using the library sources of commit {lib_old['git_commit'][:12]}")
        else:
            print(f"note  the Passport's library version {lib_old['source_tree_sha256'][:16]} is not this checkout's "
                  "and no recorded commit provides it; check out the commit that has it")
    with fin_lib.using(lib_root) if lib_root else contextlib.nullcontext():
        return _verify(a, old, t, cand, lib_old)


def _verify(a, old, t, cand, lib_old):
    new = passport.run(cand, t, cases=old["checks"]["property_tests"]["cases"] - (1 if hasattr(t.oracle, "FLAGSHIP") else 0),
                       seed=old["checks"]["property_tests"].get("seed") or 0)
    lib_new = new.get("library") or {"vendored": False}
    # An executable's hash depends on the CPU architecture it was built for; compare it only
    # when this machine builds for the Passport's platform. Its test result is always compared.
    old_platform, new_platform = old["executable"].get("platform"), new["executable"].get("platform")
    same_platform = old_platform in (None, new_platform)
    checks = [
        ("locked manifest", old["locked"]["manifest_sha256"], new["locked"]["manifest_sha256"]),
        ("solution tree", old["solution"]["solution_tree_sha256"], new["solution"]["solution_tree_sha256"]),
    ] + ([("executable", old["executable"]["sha256"], new["executable"]["sha256"])] if same_platform else []) + [
        ("executable tests", old["executable"]["status"], new["executable"]["status"]),
        ("component status", old["status"], new["status"]),
    ] + [(f"{r['id']} status", r["status"], n["status"]) for r, n in zip(old["requirements"], new["requirements"])] \
      + [(f"{r['id']} statement", r["statement_sha256"], n["statement_sha256"]) for r, n in zip(old["requirements"], new["requirements"])] \
      + [("Lean toolchain", old["toolchain"]["lean"], new["toolchain"]["lean"]),
         ("library vendored", bool(lib_old.get("vendored")), bool(lib_new.get("vendored")))]
    if lib_old.get("vendored"):
        checks += [
            ("library source tree", lib_old.get("source_tree_sha256"), lib_new.get("source_tree_sha256")),
            ("library imports", lib_old.get("imported"), lib_new.get("imported")),
            ("library scan", (lib_old.get("scan") or {}).get("passed"), (lib_new.get("scan") or {}).get("passed")),
        ]
    # The judge image digest depends on the apt packages at build time, so a rebuilt image can
    # differ; it is compared and reported, and counted only with --strict-image.
    old_image, new_image = old["toolchain"].get("judge_image"), new["toolchain"].get("judge_image")
    if getattr(a, "strict_image", False):
        checks.append(("judge image", old_image, new_image))
    # A Passport issued with the counterexample stage: re-check every recorded refutation.
    recorded = old.get("counterexamples")
    if recorded:
        again = cexmod.recheck(t, cand, recorded)
        for r, n in zip(recorded, again):
            rid = r.get("requirement")
            checks += [
                (f"{rid} counterexample statement", r.get("statement"), n.get("statement")),
                (f"{rid} counterexample source", r.get("lean_file_sha256"),
                 cexmod.sha256_text(r["lean_source"]) if r.get("lean_source") else None),
                (f"{rid} counterexample challenge", r.get("challenge_sha256"), n.get("challenge_sha256")),
                (f"{rid} counterexample kernel check", r.get("kernel_checked"), n.get("kernel_checked")),
                (f"{rid} counterexample kernels", r.get("kernels"), n.get("kernels")),
                (f"{rid} counterexample axioms", r.get("axioms"), n.get("axioms")),
            ]
    bad = 0
    for name, x, y in checks:
        ok = x == y
        bad += not ok
        print(f"{'same' if ok else 'DIFFERENT':<9}  {name}: {str(x)[:20]}" + ("" if ok else f" vs {str(y)[:20]}"))
    if not same_platform:
        print(f"not compared  executable: the Passport's was built for {old_platform}, this machine builds "
              f"for {new_platform}; it was rebuilt from the same source and re-tested here")
    elif old_platform is None and old["executable"]["sha256"] != new["executable"]["sha256"]:
        print(f"note  the Passport does not record its build platform; this machine builds for {new_platform}, "
              "and an executable built for another CPU architecture has a different hash")
    if not getattr(a, "strict_image", False):
        print(f"{'same' if old_image == new_image else 'note':<9}  judge image: {str(old_image)[:27]}"
              + ("" if old_image == new_image else f" vs {str(new_image)[:27]} (not counted; --strict-image counts it)"))
    if bad:
        print(f"NOT reproduced: {bad} differences")
    else:
        print("reproduced" if same_platform else f"reproduced, except the executable hash ({old_platform} vs {new_platform})")
    return 0 if not bad else 1


def cmd_tasks(a):
    for t in taskmod.all_tasks(a.split):
        print(f"{t.id:<32} {t.family:<14} {t.split:<5} {len(t.requirements)} requirements")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="proofforge")
    sub = ap.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("check")
    c.add_argument("--task", default="payout-flagship")
    c.add_argument("--candidate", help="candidate .lean file or workspace dir (default: the task's start candidate)")
    c.add_argument("--cases", type=int, default=2000)
    c.add_argument("--seed", type=int, default=0)
    c.add_argument("--out")
    c.add_argument("--comment")
    c.add_argument("--no-counterexample", action="store_true",
                   help="skip the kernel-checked counterexample stage for a REFUTED candidate")
    v = sub.add_parser("verify")
    v.add_argument("passport")
    v.add_argument("--candidate", required=True)
    v.add_argument("--strict-image", action="store_true",
                   help="count a different judge image digest as a difference")
    s = sub.add_parser("tasks")
    s.add_argument("--split")
    a = ap.parse_args()
    return {"check": cmd_check, "verify": cmd_verify, "tasks": cmd_tasks}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())
