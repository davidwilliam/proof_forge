# API image: the pinned Lean image plus the API server, agents, harness, locked tasks and
# recordings. The judge runs in-image (PF_IN_IMAGE=1); the host must allow the user
# namespaces Comparator's bubblewrap sandbox needs. META_API_KEY is supplied at run time.
# LEAN_IMAGE names the same pinned image in a registry when the build runs elsewhere.
ARG LEAN_IMAGE=proofforge-lean:4.35.0
FROM ${LEAN_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv \
 && rm -rf /var/lib/apt/lists/*
COPY server/requirements.txt /opt/proofforge/server/requirements.txt
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r /opt/proofforge/server/requirements.txt
COPY . /opt/proofforge
RUN mkdir -p /opt/proofforge/runs /opt/proofforge-fin && chown -R forge:forge /opt/proofforge /opt/proofforge-fin
ENV PF_IN_IMAGE=1 PYTHONDONTWRITEBYTECODE=1 PF_CONTAINER_SLOTS=2 PF_FIN_CACHE=/opt/proofforge-fin
# ProofForgeFin built once from the library sources in this image (harness/fin_lib.py), so a
# judged candidate that imports it and a live job with the library do not wait for the build.
# The cache is keyed by the library's source tree hash, so it always matches lib/ in the image.
USER forge
RUN cd /opt/proofforge && python3 harness/fin_lib.py build
USER root
WORKDIR /opt/proofforge
EXPOSE 8000
# Starts as root only to hand the data volume to the forge user, then runs as forge.
CMD ["/opt/proofforge/infra/docker/start-api.sh"]
