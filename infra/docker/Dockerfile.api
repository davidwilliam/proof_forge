# API image: the pinned Lean image plus the API server, agents, harness, locked tasks and
# recordings. The judge runs in-image (PF_IN_IMAGE=1); the host must allow the user
# namespaces Comparator's bubblewrap sandbox needs. META_API_KEY is supplied at run time.
FROM proofforge-lean:4.35.0
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv \
 && rm -rf /var/lib/apt/lists/*
COPY server/requirements.txt /opt/proofforge/server/requirements.txt
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r /opt/proofforge/server/requirements.txt
COPY . /opt/proofforge
RUN mkdir -p /opt/proofforge/runs && chown -R forge:forge /opt/proofforge
USER forge
ENV PF_IN_IMAGE=1 PYTHONDONTWRITEBYTECODE=1 PF_CONTAINER_SLOTS=2
WORKDIR /opt/proofforge
EXPOSE 8000
CMD ["/opt/venv/bin/uvicorn", "server.app:app", "--host", "0.0.0.0", "--port", "8000"]
