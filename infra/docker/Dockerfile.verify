# Verify image: the pinned Lean image plus the trusted harness and locked tasks.
# Candidates are mounted at run time; nothing from a candidate's repository is executed
# except the candidate Lean files, which Comparator builds inside its sandbox.
FROM proofforge-lean:4.35.0
USER root
COPY harness /opt/proofforge/harness
COPY formal /opt/proofforge/formal
COPY tasks /opt/proofforge/tasks
RUN chown -R forge:forge /opt/proofforge
USER forge
ENV PF_IN_IMAGE=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /work
ENTRYPOINT ["python3", "/opt/proofforge/harness/passport.py"]
