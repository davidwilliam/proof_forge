      "lean_source": "import Solution\nimport VyperSqrt.Spec\nimport VyperSqrt.Lemmas\n\n/-!\nGenerated by harness/counterexample.py. Refutes `VyperSqrt.req_sqrt_not_above` (REQ-SQRT-NOT-ABOVE) for the candidate's definitions\non the failing case\n\n{\"op\": \"sqrt\", \"x\": 9999999998}\n\nsqrt at x = 9999999998 / 10^10\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace VyperSqrt\n\ntheorem cex_req_sqrt_not_above : \u00ac (SqrtNotAbove sqrt) := by\n  intro h\n  have hx := h ((9999999998 : Int)) _ (by first | decide | exact (Option.some_get (by decide)).symm | rfl | (simp -failIfUnchanged only [IsDecimal, SqrtNotAbove, SqrtNotBelow, SqrtTotal, SqrtNegReverts, DeployedLoop] <;> decide)) (by first | decide | exact (Option.some_get (by decide)).symm | rfl | (simp -failIfUnchanged only [IsDecimal, SqrtNotAbove, SqrtNotBelow, SqrtTotal, SqrtNegReverts, DeployedLoop] <;> decide))\n  first\n    | (revert hx; decide)\n    | (revert hx; decide +kernel)\n    | (simp -failIfUnchanged only [IsDecimal, SqrtNotAbove, SqrtNotBelow, SqrtTotal, SqrtNegReverts, DeployedLoop] at hx <;> (revert hx; decide))\n    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)\n\nend VyperSqrt\n",
