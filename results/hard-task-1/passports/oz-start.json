      "lean_source": "import Solution\nimport OzSqrt.Spec\nimport OzSqrt.Lemmas\n\n/-!\nGenerated by harness/counterexample.py. Refutes `OzSqrt.req_mint_full` (REQ-MINT-FULL) for the candidate's definitions\non the failing case\n\n{\"amount0\": 5070602400912917605986812821505, \"amount1\": 5070602400912917605986812821503, \"op\": \"first_mint\"}\n\nfirst deposit of 5070602400912917605986812821505 and 5070602400912917605986812821503\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace OzSqrt\n\ntheorem cex_req_mint_full : \u00ac (MintFull sqrt) := by\n  intro h\n  have hx := h (5070602400912917605986812821505) (5070602400912917605986812821503) _ (by first | decide | exact (Option.some_get (by decide)).symm | rfl | (simp -failIfUnchanged only [SqrtNotAbove, SqrtNotBelow, SqrtUpCovers, SqrtUpTight, NewtonBudget, MintBacked, MintFull, MintLive] <;> decide))\n  first\n    | (revert hx; decide)\n    | (revert hx; decide +kernel)\n    | (simp -failIfUnchanged only [SqrtNotAbove, SqrtNotBelow, SqrtUpCovers, SqrtUpTight, NewtonBudget, MintBacked, MintFull, MintLive] at hx <;> (revert hx; decide))\n    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)\n\nend OzSqrt\n",
