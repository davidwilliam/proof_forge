import Solution
import OrderRouter.Spec
import OrderRouter.Lemmas

/-!
Generated by harness/counterexample.py. Refutes `OrderRouter.req_normal_order_routed` (REQ-NORMAL-ORDER-ROUTED) for the candidate's definitions
on the failing case

{"build": "legacy", "events": [{"flag": true, "kind": "parent", "qty": 300}, {"id": 0, "kind": "route", "liq": 100}, {"child": 0, "kind": "fill", "qty": 100}, {"id": 0, "kind": "route", "liq": 100}, {"child": 1, "kind": "fill", "qty": 100}, {"id": 0, "kind": "route", "liq": 100}, {"child": 2, "kind": "fill", "qty": 100}, {"id": 0, "kind": "route", "liq": 100}]}

the normal order with flag True on the legacy build
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 20000000

namespace OrderRouter

theorem cex_req_normal_order_routed : ¬ (NormalOrderRouted step) := by
  intro h
  have hx := h (.legacy) (true)
  first
    | (revert hx; decide)
    | (revert hx; decide +kernel)
    | (simp -failIfUnchanged only [NormalOrderRouted, RoutesAvailable, NeverOverroute, StopWhenFilled, NoExcessExecution, FillAccounting] at hx <;> (revert hx; decide))
    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)

end OrderRouter
