import Solution
import OrderRouter.Spec
import OrderRouter.Lemmas

/-!
Generated by harness/counterexample.py. Refutes `OrderRouter.req_no_excess_execution` (REQ-NO-EXCESS-EXECUTION) for the candidate's definitions
on the failing case

{"build": "legacy", "events": [{"flag": true, "kind": "parent", "qty": 100}, {"id": 0, "kind": "route", "liq": 50}, {"child": 0, "kind": "fill", "qty": 456}, {"id": 0, "kind": "route", "liq": 653}, {"child": 1, "kind": "fill", "qty": 100}, {"id": 0, "kind": "route", "liq": 428}, {"id": 0, "kind": "route", "liq": 100}, {"child": 1, "kind": "fill", "qty": 976}, {"id": 0, "kind": "route", "liq": 100}, {"child": 1, "kind": "fill", "qty": 100}]}

the first 5 events on the legacy build, parent 0
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 20000000

namespace OrderRouter

theorem cex_req_no_excess_execution : ¬ (NoExcessExecution step) := by
  intro h
  have hx := h (.legacy) (([(Event.parent 100 true), (Event.route 0 50), (Event.fill 0 456), (Event.route 0 653), (Event.fill 1 100)] : List Event)) (0)
  first
    | (revert hx; decide)
    | (revert hx; decide +kernel)
    | (simp -failIfUnchanged only [NormalOrderRouted, RoutesAvailable, NeverOverroute, StopWhenFilled, NoExcessExecution, FillAccounting] at hx <;> (revert hx; decide))
    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)

end OrderRouter
