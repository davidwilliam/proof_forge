      "lean_source": "import Solution\nimport EqualSplit.Spec\n\n/-!\nGenerated by harness/counterexample.py. Refutes `EqualSplit.req_valid_succeeds` (REQ-VALID-SUCCEEDS) for the candidate's definitions\non the failing case\n\n{\"amount\": -101, \"n\": 4}\n\namount -101 among 4 parties\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace EqualSplit\n\ntheorem cex_req_valid_succeeds : \u00ac (ValidSucceeds split) := by\n  intro h\n  have hx := h ((-101 : Int)) (4)\n  first\n    | (revert hx; decide)\n    | (revert hx; decide +kernel)\n    | (simp -failIfUnchanged only [OneShareEachOn, ConservesOn, WithinOneUnitOn, SignOn, ValidSucceeds, InvalidFails, OneShareEach, Conserves, WithinOneUnit, Sign] at hx <;> (revert hx; decide))\n    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)\n\nend EqualSplit\n",
