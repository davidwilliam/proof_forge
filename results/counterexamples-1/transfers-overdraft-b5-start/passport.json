      "lean_source": "import Solution\nimport Transfer.Spec\n\n/-!\nGenerated by harness/counterexample.py. Refutes `Transfer.req_valid_succeeds` (REQ-VALID-SUCCEEDS) for the candidate's definitions\non the failing case\n\n{\"request\": {\"amount\": 150, \"requester\": 3, \"source\": 1, \"target\": 2, \"txId\": 8}, \"state\": {\"applied\": [5], \"auth\": [[1, 1], [3, 1]], \"balances\": [[1, 100], [2, 0], [3, 40]], \"limits\": [[1, 50], [3, 10]]}}\n\nthe case's state and request\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace Transfer\n\ntheorem cex_req_valid_succeeds : \u00ac (ValidSucceeds step) := by\n  intro h\n  have hx := h (({ accounts := ([1, 2, 3] : List Nat), balance := (fun a => (([(1, (100 : Int)), (2, (0 : Int)), (3, (40 : Int))] : List (Nat \u00d7 Int)).lookup a).getD 0), limit := (fun a => (([(1, 50), (3, 10)] : List (Nat \u00d7 Nat)).lookup a).getD 0), auth := (fun req src => ([(1, 1), (3, 1)] : List (Nat \u00d7 Nat)).any (fun p => p.1 == req && p.2 == src)), applied := ([5] : List Nat) } : State)) (({ txId := 8, requester := 3, source := 1, target := 2, amount := 150 } : Request))\n  first\n    | (revert hx; decide)\n    | (revert hx; decide +kernel)\n    | (simp -failIfUnchanged only [WithinLimits, ValidTransfer, ValidSucceeds, InvalidNoop, AuthorizedOnly, DebitCredit, Effects, Idempotent, LimitRespected, Conserves] at hx <;> (revert hx; decide))\n    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)\n\nend Transfer\n",
