import Solution
import ShareVault.Spec

/-!
Generated by harness/counterexample.py. Refutes `ShareVault.req_share_value` (REQ-SHARE-VALUE) for the candidate's definitions
on the failing case

{"ops": [{"amount": 400000000, "op": "deposit", "who": 1}, {"op": "redeem", "shares": 19999999998, "who": 1}, {"amount": 50030063816, "op": "donate"}, {"amount": 50030063815, "op": "withdraw", "who": 1}]}

after 3 operations a share is worth 50030063817/2, after 4 it is worth 2/1
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 20000000

namespace ShareVault

theorem cex_req_share_value : ¬ (ShareValueNeverFalls vault) := by
  intro h
  have hx := h (([(Op.call (Call.deposit 1 400000000)), (Op.call (Call.redeem 1 19999999998)), (Op.donate 50030063816)] : List Op)) (([(Op.call (Call.withdraw 1 50030063815))] : List Op))
  first
    | (revert hx; decide)
    | (revert hx; decide +kernel)
    | (simp -failIfUnchanged only [Minted, Burned, ValueNotBelow, DepositSucceeds, RedeemSucceeds, WithdrawSucceeds, DepositEffects, RedeemEffects, WithdrawEffects, DepositRoundsDown, RedeemRoundsDown, WithdrawRoundsUp, ShareValueNeverFalls] at hx <;> (revert hx; decide))
    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)

end ShareVault
