      "lean_source": "import Solution\nimport ShareVault.Spec\n\n/-!\nGenerated by harness/counterexample.py. Refutes `ShareVault.req_redeem_succeeds` (REQ-REDEEM-SUCCEEDS) for the candidate's definitions\non the failing case\n\n{\"ops\": [{\"amount\": 38124273393, \"op\": \"deposit\", \"who\": 1}, {\"amount\": 46, \"op\": \"deposit\", \"who\": 1}, {\"op\": \"redeem\", \"shares\": 0, \"who\": 1}, {\"amount\": 683321, \"op\": \"deposit\", \"who\": 1}], \"start\": {\"assets\": 0, \"balances\": [0, 148442762010], \"supply\": 148442762010}}\n\nstep 2, {'op': 'redeem', 'who': 1, 'shares': 0}, from the reported state before it\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace ShareVault\n\ntheorem cex_req_redeem_succeeds : \u00ac (RedeemSucceeds vault) := by\n  intro h\n  have hx := h (({ assets := 0, supply := 148442762010, balance := (fun b => ([0, 148442762010] : List Nat).getD b 0) } : Vault)) (1) (0)\n  first\n    | (revert hx; decide)\n    | (revert hx; decide +kernel)\n    | (simp -failIfUnchanged only [Minted, Burned, ValueNotBelow, DepositSucceeds, RedeemSucceeds, WithdrawSucceeds, DepositEffects, RedeemEffects, WithdrawEffects, DepositRoundsDown, RedeemRoundsDown, WithdrawRoundsUp, ShareValueNeverFalls] at hx <;> (revert hx; decide))\n    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)\n\nend ShareVault\n",
