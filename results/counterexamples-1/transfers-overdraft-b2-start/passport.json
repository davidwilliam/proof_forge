      "lean_source": "import Solution\nimport Transfer.Spec\n\n/-!\nGenerated by harness/counterexample.py. Refutes `Transfer.req_invalid_noop` (REQ-INVALID-NOOP) for the candidate's definitions\non the failing case\n\n{\"request\": {\"amount\": 2, \"requester\": 3, \"source\": 3, \"target\": 3, \"txId\": 63}, \"state\": {\"applied\": [11, 19, 8], \"auth\": [[49, 33], [27, 27], [27, 17], [3, 49], [17, 3], [33, 49], [33, 33], [3, 3]], \"balances\": [[49, 0], [27, 23], [3, 3907], [17, 0], [33, 0]], \"limits\": [[49, 20], [27, 0], [3, 294], [17, 1544], [33, 302]]}}\n\nthe case's state and request\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace Transfer\n\ntheorem cex_req_invalid_noop : \u00ac (InvalidNoop step) := by\n  intro h\n  have hx := h (({ accounts := ([49, 27, 3, 17, 33] : List Nat), balance := (fun a => (([(49, (0 : Int)), (27, (23 : Int)), (3, (3907 : Int)), (17, (0 : Int)), (33, (0 : Int))] : List (Nat \u00d7 Int)).lookup a).getD 0), limit := (fun a => (([(49, 20), (27, 0), (3, 294), (17, 1544), (33, 302)] : List (Nat \u00d7 Nat)).lookup a).getD 0), auth := (fun req src => ([(49, 33), (27, 27), (27, 17), (3, 49), (17, 3), (33, 49), (33, 33), (3, 3)] : List (Nat \u00d7 Nat)).any (fun p => p.1 == req && p.2 == src)), applied := ([11, 19, 8] : List Nat) } : State)) (({ txId := 63, requester := 3, source := 3, target := 3, amount := 2 } : Request)) (by first | decide | exact (Option.some_get (by decide)).symm | rfl | (simp -failIfUnchanged only [WithinLimits, ValidTransfer, ValidSucceeds, InvalidNoop, AuthorizedOnly, DebitCredit, Effects, Idempotent, LimitRespected, Conserves] <;> decide))\n  first\n    | (have hy := congrArg (fun p : Outcome \u00d7 State => p.1) (hx); revert hy; first | decide | decide +kernel)\n    | (have hy := congrArg (fun p : Outcome \u00d7 State => p.2.accounts) (hx); revert hy; first | decide | decide +kernel)\n    | (have hy := congrArg (fun p : Outcome \u00d7 State => p.2.accounts.map p.2.balance) (hx); revert hy; first | decide | decide +kernel)\n    | (have hy := congrArg (fun p : Outcome \u00d7 State => p.2.accounts.map p.2.limit) (hx); revert hy; first | decide | decide +kernel)\n    | (have hy := congrArg (fun p : Outcome \u00d7 State => p.2.accounts.flatMap (fun a => p.2.accounts.map (fun b => p.2.auth a b))) (hx); revert hy; first | decide | decide +kernel)\n    | (have hy := congrArg (fun p : Outcome \u00d7 State => p.2.applied) (hx); revert hy; first | decide | decide +kernel)\n\nend Transfer\n",
