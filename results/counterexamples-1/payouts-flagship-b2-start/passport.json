      "lean_source": "import Solution\nimport Payout.Spec\n\n/-!\nGenerated by harness/counterexample.py. Refutes `Payout.req_fair_shares` (REQ-FAIR-SHARES) for the candidate's definitions\non the failing case\n\n{\"request\": {\"amount\": 100, \"recipients\": [2, 3, 4], \"requester\": 1, \"source\": 1, \"txId\": 7}, \"state\": {\"applied\": [3], \"auth\": [[1, 1]], \"balances\": [[1, 1000], [2, 0], [3, 0], [4, 0]]}}\n\nthe case's state and request\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace Payout\n\ntheorem cex_req_fair_shares : \u00ac (FairShares step) := by\n  intro h\n  have hx := h (({ accounts := ([1, 2, 3, 4] : List Nat), balance := (fun a => (([(1, (1000 : Int)), (2, (0 : Int)), (3, (0 : Int)), (4, (0 : Int))] : List (Nat \u00d7 Int)).lookup a).getD 0), auth := (fun req src => ([(1, 1)] : List (Nat \u00d7 Nat)).any (fun p => p.1 == req && p.2 == src)), applied := ([3] : List Nat) } : State)) (({ txId := 7, requester := 1, source := 1, recipients := ([2, 3, 4] : List Nat), amount := 100 } : Request))\n  first\n    | (revert hx; decide)\n    | (revert hx; decide +kernel)\n    | (simp -failIfUnchanged only [ValidPayout, ValidSucceeds, InvalidNoop, FairShares, Effects, Conserves, NonNegative, AuthorizedOnly, Idempotent] at hx <;> (revert hx; decide))\n    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)\n\nend Payout\n",
