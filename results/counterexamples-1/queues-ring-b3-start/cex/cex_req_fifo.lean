namespace RingBuffer

theorem cex_req_fifo : ¬ (Fifo step) := by
  intro h
  have hx := h (({ capacity := 3, buf := (fun i => [7, 8, 4].getD i 0), head := 0, count := 3 } : State)) ([(Op.enqueue 80)])
  first
    | (revert hx; decide)
    | (revert hx; decide +kernel)
    | (simp -failIfUnchanged only [WellFormed, Valid, ValidSucceeds, InvalidNoop, KeepsWellFormed, EnqueueEffects, DequeueEffects, EnqueueContents, DequeueContents, Fifo] at hx <;> (revert hx; decide))
    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)

end RingBuffer
