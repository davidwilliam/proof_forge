      "lean_source": "import Solution\nimport RingBuffer.Spec\n\n/-!\nGenerated by harness/counterexample.py. Refutes `RingBuffer.req_fifo` (REQ-FIFO) for the candidate's definitions\non the failing case\n\n{\"op\": {\"kind\": \"enqueue\", \"value\": 80}, \"state\": {\"capacity\": 3, \"count\": 3, \"head\": 0, \"slots\": [7, 8, 4]}}\n\nthe case's state and enqueue\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace RingBuffer\n\ntheorem cex_req_fifo : \u00ac (Fifo step) := by\n  intro h\n  have hx := h (({ capacity := 3, buf := (fun i => [7, 8, 4].getD i 0), head := 0, count := 3 } : State)) ([(Op.enqueue 80)])\n  first\n    | (revert hx; decide)\n    | (revert hx; decide +kernel)\n    | (simp -failIfUnchanged only [WellFormed, Valid, ValidSucceeds, InvalidNoop, KeepsWellFormed, EnqueueEffects, DequeueEffects, EnqueueContents, DequeueContents, Fifo] at hx <;> (revert hx; decide))\n    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)\n\nend RingBuffer\n",
