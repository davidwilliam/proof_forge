      "lean_source": "import Solution\nimport RingBuffer.Spec\n\n/-!\nGenerated by harness/counterexample.py. Refutes `RingBuffer.req_enqueue_effects` (REQ-ENQUEUE-EFFECTS) for the candidate's definitions\non the failing case\n\n{\"op\": {\"kind\": \"enqueue\", \"value\": 86}, \"state\": {\"capacity\": 4, \"count\": 1, \"head\": 3, \"slots\": [9, 8, 9, 4]}}\n\nthe case's state and enqueue\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace RingBuffer\n\ntheorem cex_req_enqueue_effects : \u00ac (EnqueueEffects step) := by\n  intro h\n  have hx := h (({ capacity := 4, buf := (fun i => [9, 8, 9, 4].getD i 0), head := 3, count := 1 } : State)) (86) (by first | decide | exact (Option.some_get (by decide)).symm | rfl | (simp -failIfUnchanged only [WellFormed, Valid, ValidSucceeds, InvalidNoop, KeepsWellFormed, EnqueueEffects, DequeueEffects, EnqueueContents, DequeueContents, Fifo] <;> decide))\n  first\n    | (have hy := congrArg (fun p : Outcome \u00d7 State => p.1) (hx); revert hy; first | decide | decide +kernel)\n    | (have hy := congrArg (fun p : Outcome \u00d7 State => p.2.capacity) (hx); revert hy; first | decide | decide +kernel)\n    | (have hy := congrArg (fun p : Outcome \u00d7 State => p.2.head) (hx); revert hy; first | decide | decide +kernel)\n    | (have hy := congrArg (fun p : Outcome \u00d7 State => p.2.count) (hx); revert hy; first | decide | decide +kernel)\n    | (have hy := congrArg (fun p : Outcome \u00d7 State => (List.range p.2.capacity).map p.2.buf) (hx); revert hy; first | decide | decide +kernel)\n\nend RingBuffer\n",
