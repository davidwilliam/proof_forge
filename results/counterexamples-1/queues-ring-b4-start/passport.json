      "lean_source": "import Solution\nimport RingBuffer.Spec\n\n/-!\nGenerated by harness/counterexample.py. Refutes `RingBuffer.req_fifo` (REQ-FIFO) for the candidate's definitions\non the failing case\n\n{\"op\": {\"kind\": \"enqueue\", \"value\": 86}, \"state\": {\"capacity\": 4, \"count\": 1, \"head\": 3, \"slots\": [9, 8, 9, 4]}}\n\nthe case's state and enqueue\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace RingBuffer\n\ntheorem cex_req_fifo : \u00ac (Fifo step) := by\n  intro h\n  have hx := h (({ capacity := 4, buf := (fun i => [9, 8, 9, 4].getD i 0), head := 3, count := 1 } : State)) ([(Op.enqueue 86)])\n  first\n    | (revert hx; decide)\n    | (revert hx; decide +kernel)\n    | (simp -failIfUnchanged only [WellFormed, Valid, ValidSucceeds, InvalidNoop, KeepsWellFormed, EnqueueEffects, DequeueEffects, EnqueueContents, DequeueContents, Fifo] at hx <;> (revert hx; decide))\n    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)\n\nend RingBuffer\n",
