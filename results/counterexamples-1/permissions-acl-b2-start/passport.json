      "lean_source": "import Solution\nimport Acl.Spec\n\n/-!\nGenerated by harness/counterexample.py. Refutes `Acl.req_denial_explained` (REQ-DENIAL-EXPLAINED) for the candidate's definitions\non the failing case\n\n{\"request\": {\"path\": [7, 2, 5, 1], \"user\": 1}, \"state\": {\"entries\": [[\"allow\", 0, [7]], [\"deny\", 0, [7, 2]], [\"allow\", 1, [7, 2, 5]]], \"log\": [], \"users\": [1, 2]}}\n\nthe case's state and check\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace Acl\n\ntheorem cex_req_denial_explained : \u00ac (DenialExplained step) := by\n  intro h\n  have hx := h (({ users := ([1, 2] : List Nat), entries := ([\u27e8.allow, 0, ([7] : List Nat)\u27e9, \u27e8.deny, 0, ([7, 2] : List Nat)\u27e9, \u27e8.allow, 1, ([7, 2, 5] : List Nat)\u27e9] : List Entry), log := ([] : List Record) } : State)) (({ user := 1, path := ([7, 2, 5, 1] : List Nat) } : Request))\n  first\n    | (revert hx; decide)\n    | (revert hx; decide +kernel)\n    | (simp -failIfUnchanged only [ValidQuery, Matches, HasAllow, Overridden, Permitted, ValidAnswered, InvalidNoop, Effects, DefaultDeny, DenyOverrides, SpecificAllow, GrantJustified, OrderIndependent, DenialExplained] at hx <;> (revert hx; decide))\n    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)\n\nend Acl\n",
