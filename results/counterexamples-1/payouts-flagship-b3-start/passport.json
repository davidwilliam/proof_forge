      "lean_source": "import Solution\nimport Payout.Spec\n\n/-!\nGenerated by harness/counterexample.py. Refutes `Payout.req_invalid_noop` (REQ-INVALID-NOOP) for the candidate's definitions\non the failing case\n\n{\"request\": {\"amount\": 1294, \"recipients\": [30, 12], \"requester\": 12, \"source\": 12, \"txId\": 95}, \"state\": {\"applied\": [13], \"auth\": [[12, 30], [30, 8], [8, 30], [12, 12]], \"balances\": [[12, 2821], [30, 0], [8, 13]]}}\n\nthe case's state and request\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace Payout\n\ntheorem cex_req_invalid_noop : \u00ac (InvalidNoop step) := by\n  intro h\n  have hx := h (({ accounts := ([12, 30, 8] : List Nat), balance := (fun a => (([(12, (2821 : Int)), (30, (0 : Int)), (8, (13 : Int))] : List (Nat \u00d7 Int)).lookup a).getD 0), auth := (fun req src => ([(12, 30), (30, 8), (8, 30), (12, 12)] : List (Nat \u00d7 Nat)).any (fun p => p.1 == req && p.2 == src)), applied := ([13] : List Nat) } : State)) (({ txId := 95, requester := 12, source := 12, recipients := ([30, 12] : List Nat), amount := 1294 } : Request)) (by first | decide | exact (Option.some_get (by decide)).symm | rfl | (simp -failIfUnchanged only [ValidPayout, ValidSucceeds, InvalidNoop, FairShares, Effects, Conserves, NonNegative, AuthorizedOnly, Idempotent] <;> decide))\n  first\n    | (have hy := congrArg (fun p : Outcome \u00d7 State => p.1) (hx); revert hy; first | decide | decide +kernel)\n    | (have hy := congrArg (fun p : Outcome \u00d7 State => p.2.accounts) (hx); revert hy; first | decide | decide +kernel)\n    | (have hy := congrArg (fun p : Outcome \u00d7 State => p.2.accounts.map p.2.balance) (hx); revert hy; first | decide | decide +kernel)\n    | (have hy := congrArg (fun p : Outcome \u00d7 State => p.2.accounts.flatMap (fun a => p.2.accounts.map (fun b => p.2.auth a b))) (hx); revert hy; first | decide | decide +kernel)\n    | (have hy := congrArg (fun p : Outcome \u00d7 State => p.2.applied) (hx); revert hy; first | decide | decide +kernel)\n\nend Payout\n",
