      "lean_source": "import Solution\nimport Acl.Spec\n\n/-!\nGenerated by harness/counterexample.py. Refutes `Acl.req_deny_overrides` (REQ-DENY-OVERRIDES) for the candidate's definitions\non the failing case\n\n{\"request\": {\"path\": [2, 3, 1], \"user\": 5}, \"state\": {\"entries\": [[\"allow\", 0, [2, 3]], [\"deny\", 0, [2, 3]]], \"log\": [[8, [3], false], [1, [2, 2], false]], \"users\": [7, 1, 5, 8]}}\n\nthe case's state and check\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace Acl\n\ntheorem cex_req_deny_overrides : \u00ac (DenyOverrides step) := by\n  intro h\n  have hx := h (({ users := ([7, 1, 5, 8] : List Nat), entries := ([\u27e8.allow, 0, ([2, 3] : List Nat)\u27e9, \u27e8.deny, 0, ([2, 3] : List Nat)\u27e9] : List Entry), log := ([\u27e88, ([3] : List Nat), false\u27e9, \u27e81, ([2, 2] : List Nat), false\u27e9] : List Record) } : State)) (({ user := 5, path := ([2, 3, 1] : List Nat) } : Request))\n  first\n    | (revert hx; decide)\n    | (revert hx; decide +kernel)\n    | (simp -failIfUnchanged only [ValidQuery, Matches, HasAllow, Overridden, Permitted, ValidAnswered, InvalidNoop, Effects, DefaultDeny, DenyOverrides, SpecificAllow, GrantJustified, OrderIndependent, DenialExplained] at hx <;> (revert hx; decide))\n    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)\n\nend Acl\n",
