import Solution
import Transfer.Spec

/-!
Generated by harness/counterexample.py. Refutes `Transfer.req_idempotency` (REQ-IDEMPOTENCY) for the candidate's definitions
on the failing case

{"request": {"amount": 150, "requester": 3, "source": 1, "target": 2, "txId": 8}, "state": {"applied": [5], "auth": [[1, 1], [3, 1]], "balances": [[1, 100], [2, 0], [3, 40]], "limits": [[1, 50], [3, 10]]}}

the case's state and request
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 20000000

namespace Transfer

theorem cex_req_idempotency : ¬ (Idempotent step) := by
  intro h
  have hx := h ({ accounts := ([1, 2, 3] : List Nat), balance := (fun a => (([(1, (100 : Int)), (2, (0 : Int)), (3, (40 : Int))] : List (Nat × Int)).lookup a).getD 0), limit := (fun a => (([(1, 50), (3, 10)] : List (Nat × Nat)).lookup a).getD 0), auth := (fun req src => ([(1, 1), (3, 1)] : List (Nat × Nat)).any (fun p => p.1 == req && p.2 == src)), applied := ([5] : List Nat) } : State) ({ txId := 8, requester := 3, source := 1, target := 2, amount := 150 } : Request) (by decide)
  first
    | exact absurd ((hx.1 5).mp) (by decide)
    | exact absurd ((hx.1 8).mp) (by decide)
    | exact absurd ((hx.1 5).mpr) (by decide)
    | exact absurd ((hx.1 8).mpr) (by decide)
    | (have hy := congrArg (fun p : Outcome × State => p.1) hx.2; revert hy; first | decide | decide +kernel)
    | (have hy := congrArg (fun p : Outcome × State => p.2.accounts) hx.2; revert hy; first | decide | decide +kernel)
    | (have hy := congrArg (fun p : Outcome × State => p.2.accounts.map p.2.balance) hx.2; revert hy; first | decide | decide +kernel)
    | (have hy := congrArg (fun p : Outcome × State => p.2.accounts.map p.2.limit) hx.2; revert hy; first | decide | decide +kernel)
    | (have hy := congrArg (fun p : Outcome × State => p.2.accounts.flatMap (fun a => p.2.accounts.map (fun b => p.2.auth a b))) hx.2; revert hy; first | decide | decide +kernel)
    | (have hy := congrArg (fun p : Outcome × State => p.2.applied) hx.2; revert hy; first | decide | decide +kernel)

end Transfer
