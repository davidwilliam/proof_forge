      "lean_source": "import Solution\nimport Allocation.Spec\n\n/-!\nGenerated by harness/counterexample.py. Refutes `Allocation.req_conservation` (REQ-CONSERVATION) for the candidate's definitions\non the failing case\n\n{\"amount\": 100, \"ratios\": [1, 1, 1]}\n\namount 100, ratios [1, 1, 1]\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace Allocation\n\ntheorem cex_req_conservation : \u00ac (Conserves allocate) := by\n  intro h\n  have hx := h ((100 : Int)) (([1, 1, 1] : List Nat)) _ (by first | decide | exact (Option.some_get (by decide)).symm | rfl | (simp -failIfUnchanged only [Valid, OneShareEachOn, ConservesOn, WithinOneUnitOn, ZeroRatioOn, SignOn, LargestRemainderOn, ValidSucceeds, InvalidFails, OneShareEach, Conserves, WithinOneUnit, ZeroRatio, Sign, LargestRemainder] <;> decide))\n  first\n    | (revert hx; decide)\n    | (revert hx; decide +kernel)\n    | (simp -failIfUnchanged only [Valid, OneShareEachOn, ConservesOn, WithinOneUnitOn, ZeroRatioOn, SignOn, LargestRemainderOn, ValidSucceeds, InvalidFails, OneShareEach, Conserves, WithinOneUnit, ZeroRatio, Sign, LargestRemainder] at hx <;> (revert hx; decide))\n    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)\n\nend Allocation\n",
