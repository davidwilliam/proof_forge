      "lean_source": "import Solution\nimport RingBuffer.Spec\n\n/-!\nGenerated by harness/counterexample.py. Refutes `RingBuffer.req_fifo` (REQ-FIFO) for the candidate's definitions\non the failing case\n\n{\"op\": {\"kind\": \"dequeue\"}, \"state\": {\"capacity\": 4, \"count\": 2, \"head\": 3, \"slots\": [5, 6, 7, 8]}}\n\nthe case's state and dequeue\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace RingBuffer\n\ntheorem cex_req_fifo : \u00ac (Fifo step) := by\n  intro h\n  have hx := h (({ capacity := 4, buf := (fun i => [5, 6, 7, 8].getD i 0), head := 3, count := 2 } : State)) ([Op.dequeue])\n  first\n    | (revert hx; decide)\n    | (revert hx; decide +kernel)\n    | (simp -failIfUnchanged only [WellFormed, Valid, ValidSucceeds, InvalidNoop, KeepsWellFormed, EnqueueEffects, DequeueEffects, EnqueueContents, DequeueContents, Fifo] at hx <;> (revert hx; decide))\n    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)\n\nend RingBuffer\n",
