set_option maxRecDepth 100000
set_option maxHeartbeats 20000000

namespace Journal

theorem cex_req_trial_balance : ¬ (TrialBalance step) := by
  intro h
  have hx := h (({ accounts := ([1, 2, 3] : List Nat), balance := (fun a => (([(1, (1000 : Int)), (2, (0 : Int)), (3, (50 : Int))] : List (Nat × Int)).lookup a).getD 0), posted := ([4] : List Nat) } : State)) (({ id := 9, lines := ([(1, (-500 : Int)), (2, (300 : Int)), (1, (-200 : Int)), (3, (400 : Int))] : List (Nat × Int)) } : Entry))
  first
    | (revert hx; decide)
    | (revert hx; decide +kernel)
    | (simp -failIfUnchanged only [ValidEntry, ValidSucceeds, InvalidNoop, KnownAccounts, Balanced, Effects, Idempotent, TrialBalance] at hx <;> (revert hx; decide))
    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)

end Journal
