      "lean_source": "import Solution\nimport TokenBucket.Spec\n\n/-!\nGenerated by harness/counterexample.py. Refutes `TokenBucket.req_remaining` (REQ-REMAINING) for the candidate's definitions\non the failing case\n\n{\"request\": {\"cost\": 4, \"time\": 104}, \"state\": {\"capacity\": 10, \"last\": 100, \"rate\": 2, \"tokens\": 6}}\n\nthe case's state and request\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace TokenBucket\n\ntheorem cex_req_remaining : \u00ac (Remaining step) := by\n  intro h\n  have hx := h (({ capacity := 10, rate := 2, tokens := 6, last := 100 } : State)) (({ time := 104, cost := 4 } : Request))\n  first\n    | (revert hx; decide)\n    | (revert hx; decide +kernel)\n    | (simp -failIfUnchanged only [Admissible, ValidSucceeds, InvalidNoop, AllowIffSufficient, TimeMonotone, Remaining, Effects, CapacityBound] at hx <;> (revert hx; decide))\n    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)\n\nend TokenBucket\n",
