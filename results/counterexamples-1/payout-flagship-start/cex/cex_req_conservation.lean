set_option maxRecDepth 100000
set_option maxHeartbeats 20000000

namespace Payout

theorem cex_req_conservation : ¬ (Conserves step) := by
  intro h
  have hx := h (({ accounts := ([1, 2, 3, 4] : List Nat), balance := (fun a => (([(1, (1000 : Int)), (2, (0 : Int)), (3, (0 : Int)), (4, (0 : Int))] : List (Nat × Int)).lookup a).getD 0), auth := (fun req src => ([(1, 1)] : List (Nat × Nat)).any (fun p => p.1 == req && p.2 == src)), applied := ([3] : List Nat) } : State)) (({ txId := 7, requester := 1, source := 1, recipients := ([2, 3, 4] : List Nat), amount := 100 } : Request))
  first
    | (revert hx; decide)
    | (revert hx; decide +kernel)
    | (simp -failIfUnchanged only [ValidPayout, ValidSucceeds, InvalidNoop, FairShares, Effects, Conserves, NonNegative, AuthorizedOnly, Idempotent] at hx <;> (revert hx; decide))
    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)

end Payout
