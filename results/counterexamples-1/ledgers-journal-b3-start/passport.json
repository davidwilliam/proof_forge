      "lean_source": "import Solution\nimport Journal.Spec\n\n/-!\nGenerated by harness/counterexample.py. Refutes `Journal.req_effects` (REQ-EFFECTS) for the candidate's definitions\non the failing case\n\n{\"entry\": {\"id\": 9, \"lines\": [[1, -500], [2, 300], [1, -200], [3, 400]]}, \"state\": {\"balances\": [[1, 1000], [2, 0], [3, 50]], \"posted\": [4]}}\n\nthe case's state and entry\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace Journal\n\ntheorem cex_req_effects : \u00ac (Effects step) := by\n  intro h\n  have hx := h ({ accounts := ([1, 2, 3] : List Nat), balance := (fun a => (([(1, (1000 : Int)), (2, (0 : Int)), (3, (50 : Int))] : List (Nat \u00d7 Int)).lookup a).getD 0), posted := ([4] : List Nat) } : State) ({ id := 9, lines := ([(1, (-500 : Int)), (2, (300 : Int)), (1, (-200 : Int)), (3, (400 : Int))] : List (Nat \u00d7 Int)) } : Entry) (by decide)\n  first\n    | exact absurd hx.1 (by decide)\n    | exact absurd (hx.2 1) (by decide)\n    | exact absurd (hx.2 2) (by decide)\n    | exact absurd (hx.2 3) (by decide)\n\nend Journal\n",
