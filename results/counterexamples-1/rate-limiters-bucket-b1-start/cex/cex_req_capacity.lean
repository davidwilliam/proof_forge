set_option maxRecDepth 100000
set_option maxHeartbeats 20000000

namespace TokenBucket

theorem cex_req_capacity : ¬ (CapacityBound step) := by
  intro h
  have hx := h (({ capacity := 1, rate := 20, tokens := 1, last := 156 } : State)) (({ time := 196, cost := 533 } : Request))
  first
    | (revert hx; decide)
    | (revert hx; decide +kernel)
    | (simp -failIfUnchanged only [Admissible, ValidSucceeds, InvalidNoop, AllowIffSufficient, TimeMonotone, Remaining, Effects, CapacityBound] at hx <;> (revert hx; decide))
    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)

end TokenBucket
