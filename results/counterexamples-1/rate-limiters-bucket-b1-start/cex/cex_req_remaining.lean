import Solution
import TokenBucket.Spec

/-!
Generated by harness/counterexample.py. Refutes `TokenBucket.req_remaining` (REQ-REMAINING) for the candidate's definitions
on the failing case

{"request": {"cost": 4, "time": 104}, "state": {"capacity": 10, "last": 100, "rate": 2, "tokens": 6}}

the case's state and request
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 20000000

namespace TokenBucket

theorem cex_req_remaining : ¬ (Remaining step) := by
  intro h
  have hx := h (({ capacity := 10, rate := 2, tokens := 6, last := 100 } : State)) (({ time := 104, cost := 4 } : Request))
  first
    | (revert hx; decide)
    | (revert hx; decide +kernel)
    | (simp -failIfUnchanged only [Admissible, ValidSucceeds, InvalidNoop, AllowIffSufficient, TimeMonotone, Remaining, Effects, CapacityBound] at hx <;> (revert hx; decide))
    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)

end TokenBucket
