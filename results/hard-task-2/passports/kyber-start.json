      "lean_source": "import Solution\nimport KyberSwapStep.Spec\nimport KyberSwapStep.Lemmas\n\n/-!\nGenerated by harness/counterexample.py. Refutes `KyberSwapStep.req_in_within_target` (REQ-IN-WITHIN-TARGET) for the candidate's definitions\non the failing case\n\n{\"F\": 300, \"L\": 529700652, \"c\": 26908681593376338809905220921561871, \"exact_input\": true, \"op\": \"step\", \"spec\": 1816821696332, \"t\": 27180014754403994732126507336932861}\n\nexact-input step L=529700652 c=26908681593376338809905220921561871 t=27180014754403994732126507336932861 F=300 spec=1816821696332\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace KyberSwapStep\n\ntheorem cex_req_in_within_target : \u00ac (InWithinTarget computeSwapStep) := by\n  intro h\n  have hx := h (529700652) (26908681593376338809905220921561871) (27180014754403994732126507336932861) (300) ((1816821696332 : Int)) (({ usedAmount := (1816821696332 : Int), returnedAmount := (-14 : Int), deltaL := 8023, nextSqrtP := 27180014754675749645719300096015422 } : Step)) (by first | decide | exact (Option.some_get (by decide)).symm | rfl | (simp -failIfUnchanged only [InWindow, InRange, ExactIn, ExactOut, InWithinTarget, OutWithinTarget, StepReach, StepPaid, InFeeLiquidity, OutFeeLiquidity, PoolCrosses, DeployedStep] <;> decide)) (by first | decide | exact (Option.some_get (by decide)).symm | rfl | (simp -failIfUnchanged only [InWindow, InRange, ExactIn, ExactOut, InWithinTarget, OutWithinTarget, StepReach, StepPaid, InFeeLiquidity, OutFeeLiquidity, PoolCrosses, DeployedStep] <;> decide))\n  first\n    | (revert hx; decide)\n    | (revert hx; decide +kernel)\n\nend KyberSwapStep\n",
