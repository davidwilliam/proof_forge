      "lean_source": "import Solution\nimport BalancerSwap.Spec\nimport BalancerSwap.Sanity\n\n/-!\nGenerated by harness/counterexample.py. Refutes `BalancerSwap.req_given_out_succeeds` (REQ-GIVEN-OUT-SUCCEEDS) for the candidate's definitions\non the failing case\n\n{\"math\": \"product\", \"pool\": {\"balances\": [25325, 1], \"fee\": 1000000000000, \"rates\": [1000000000000000000, 1136813421526662182]}, \"swaps\": [{\"amount\": 0, \"in\": 0, \"kind\": \"out\", \"out\": 1}, {\"amount\": 793115, \"in\": 0, \"kind\": \"out\", \"out\": 1}, {\"amount\": 249864, \"in\": 1, \"kind\": \"in\", \"out\": 0}, {\"amount\": 856696, \"in\": 1, \"kind\": \"out\", \"out\": 2}]}\n\nswap 0 of the batch, from the reported balances [25325, 1]\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 20000000\n\nnamespace BalancerSwap\n\ntheorem cex_req_given_out_succeeds : \u00ac (GivenOutSucceeds onSwap) := by\n  intro h\n  have hx := h (constantProduct) (({ n := 2, balance := (fun k => [25325, 1].getD k 0), rate := (fun k => [1000000000000000000, 1136813421526662182].getD k 0), fee := 1000000000000 } : Pool)) (({ kind := .givenOut, tokenIn := 0, tokenOut := 1, amount := 0 } : Swap)) (by first | decide | exact (Option.some_get (by decide)).symm | rfl | exact (constantProduct_wellBehaved) | exact (constantProduct_priceMonotone) | (simp -failIfUnchanged only [InvariantMonotone, OutGivenInSound, InGivenOutSound, PriceMonotone, Valid, GivenInSucceeds, GivenOutSucceeds, GivenInPaysAtMost, GivenInPaysAtLeast, GivenOutChargesAtLeast, GivenOutChargesAtMost, SwapKeepsValue, BatchKeepsValue] <;> decide)) (by first | decide | exact (Option.some_get (by decide)).symm | rfl | exact (constantProduct_wellBehaved) | exact (constantProduct_priceMonotone) | (simp -failIfUnchanged only [InvariantMonotone, OutGivenInSound, InGivenOutSound, PriceMonotone, Valid, GivenInSucceeds, GivenOutSucceeds, GivenInPaysAtMost, GivenInPaysAtLeast, GivenOutChargesAtLeast, GivenOutChargesAtMost, SwapKeepsValue, BatchKeepsValue] <;> decide)) (by first | decide | exact (Option.some_get (by decide)).symm | rfl | exact (constantProduct_wellBehaved) | exact (constantProduct_priceMonotone) | (simp -failIfUnchanged only [InvariantMonotone, OutGivenInSound, InGivenOutSound, PriceMonotone, Valid, GivenInSucceeds, GivenOutSucceeds, GivenInPaysAtMost, GivenInPaysAtLeast, GivenOutChargesAtLeast, GivenOutChargesAtMost, SwapKeepsValue, BatchKeepsValue] <;> decide)) (by first | decide | exact (Option.some_get (by decide)).symm | rfl | exact (constantProduct_wellBehaved) | exact (constantProduct_priceMonotone) | (simp -failIfUnchanged only [InvariantMonotone, OutGivenInSound, InGivenOutSound, PriceMonotone, Valid, GivenInSucceeds, GivenOutSucceeds, GivenInPaysAtMost, GivenInPaysAtLeast, GivenOutChargesAtLeast, GivenOutChargesAtMost, SwapKeepsValue, BatchKeepsValue] <;> decide)) (by first | decide | exact (Option.some_get (by decide)).symm | rfl | exact (constantProduct_wellBehaved) | exact (constantProduct_priceMonotone) | (simp -failIfUnchanged only [InvariantMonotone, OutGivenInSound, InGivenOutSound, PriceMonotone, Valid, GivenInSucceeds, GivenOutSucceeds, GivenInPaysAtMost, GivenInPaysAtLeast, GivenOutChargesAtLeast, GivenOutChargesAtMost, SwapKeepsValue, BatchKeepsValue] <;> decide)) (by first | decide | exact (Option.some_get (by decide)).symm | rfl | exact (constantProduct_wellBehaved) | exact (constantProduct_priceMonotone) | (simp -failIfUnchanged only [InvariantMonotone, OutGivenInSound, InGivenOutSound, PriceMonotone, Valid, GivenInSucceeds, GivenOutSucceeds, GivenInPaysAtMost, GivenInPaysAtLeast, GivenOutChargesAtLeast, GivenOutChargesAtMost, SwapKeepsValue, BatchKeepsValue] <;> decide))\n  first\n    | (revert hx; decide)\n    | (revert hx; decide +kernel)\n    | (simp -failIfUnchanged only [InvariantMonotone, OutGivenInSound, InGivenOutSound, PriceMonotone, Valid, GivenInSucceeds, GivenOutSucceeds, GivenInPaysAtMost, GivenInPaysAtLeast, GivenOutChargesAtLeast, GivenOutChargesAt