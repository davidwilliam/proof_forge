tone, Valid, GivenInSucceeds, GivenOutSucceeds, GivenInPaysAtMost, GivenInPaysAtLeast, GivenOutChargesAtLeast, GivenOutChargesAtMost, SwapKeepsValue, BatchKeepsValue] <;> decide)) (by first | decide | exact (Option.some_get (by decide)).symm | rfl | exact (constantProduct_wellBehaved) | exact (constantProduct_priceMonotone) | (simp -failIfUnchanged only [InvariantMonotone, OutGivenInSound, InGivenOutSound, PriceMonotone, Valid, GivenInSucceeds, GivenOutSucceeds, GivenInPaysAtMost, GivenInPaysAtLeast, GivenOutChargesAtLeast, GivenOutChargesAtMost, SwapKeepsValue, BatchKeepsValue] <;> decide)) (by first | decide | exact (Option.some_get (by decide)).symm | rfl | exact (constantProduct_wellBehaved) | exact (constantProduct_priceMonotone) | (simp -failIfUnchanged only [InvariantMonotone, OutGivenInSound, InGivenOutSound, PriceMonotone, Valid, GivenInSucceeds, GivenOutSucceeds, GivenInPaysAtMost, GivenInPaysAtLeast, GivenOutChargesAtLeast, GivenOutChargesAtMost, SwapKeepsValue, BatchKeepsValue] <;> decide))\n  first\n    | (revert hx; decide)\n    | (revert hx; decide +kernel)\n    | (simp -failIfUnchanged only [InvariantMonotone, OutGivenInSound, InGivenOutSound, PriceMonotone, Valid, GivenInSucceeds, GivenOutSucceeds, GivenInPaysAtMost, GivenInPaysAtLeast, GivenOutChargesAtLeast, GivenOutChargesAtMost, SwapKeepsValue, BatchKeepsValue] at hx <;> (revert hx; decide))\n    | (repeat (first | exact absurd hx (by decide) | exact absurd hx.1 (by decide) | replace hx := hx.2); done)\n\nend BalancerSwap\n",
