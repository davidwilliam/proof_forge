  "colorUse": {
    "void": "page ground in dark",
    "graphite": "cards and panels on dark",
    "steel": "card edges on dark",
    "mist": "body text on dark",
    "forge": "the block on dark; one accent per view",
    "forge-deep": "the block on light; large accents on light",
    "ion": "proof graphs and Lean code on dark",
    "paper": "page ground in light",
    "verified": "the verified verdict only",
    "refuted": "the refuted verdict only",
    "ink": "text and mark on light",
    "slate": "body text on light",
    "frost": "the mark and headings on dark",
    "hairline": "card edges on light",
    "white": "cards on light; the mono white mark"
  },
  "themes": {
    "light": {
      "ground": "paper",
      "surface": "white",
      "edge": "hairline",
      "text": "ink",
      "body": "slate",
      "mark": "ink",
      "block": "forge-deep",
      "accent": "forge-deep",
      "code": "ink",
      "graph": "ink",
      "verified": "verified",
      "refuted": "refuted",
      "onVerdict": "ink"
    },
    "dark": {
      "ground": "void",
      "surface": "graphite",
      "edge": "steel",
      "text": "frost",
      "body": "mist",
      "mark": "frost",
      "block": "forge",
      "accent": "forge",
      "code": "ion",
      "graph": "ion",
      "verified": "verified",
      "refuted": "refuted",
      "onVerdict": "ink"
    }
  },
  "typography": {
    "headline": {
      "family": "Instrument Serif",
      "stack": "'Instrument Serif', Georgia, serif",
      "use": "page headlines"
    },
    "display": {
      "family": "Space Grotesk",
      "stack": "'Space Grotesk', Inter, system-ui, sans-serif",
      "weights": [
        500,
        600,
        700
      ],
      "use": "wordmark, figures, section titles"
    },
    "interface": {
      "family": "Inter",
      "stack": "Inter, system-ui, sans-serif",
      "weights": [
        400,
        500,
        600
      ],
      "use": "interface and body"
    },
    "mono": {
      "family": "JetBrains Mono",
      "stack": "'JetBrains Mono', ui-monospace, monospace",
      "weights": [
        400,
        500
      ],
      "use": "Lean, hashes, Passport readings"
    }
  },
