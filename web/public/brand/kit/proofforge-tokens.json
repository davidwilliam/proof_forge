{
  "brand": "ProofForge",
  "version": "1.0",
  "colorSpace": "sRGB",
  "colors": {
    "void": "#05070B",
    "graphite": "#0E131B",
    "steel": "#1C2532",
    "mist": "#A9B4C2",
    "forge": "#FF9A3C",
    "forge-deep": "#D45F00",
    "ion": "#5BE4F0",
    "paper": "#F6F7F9",
    "verified": "#3DDC97",
